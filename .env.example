# ==============================================================================
# OpenCohost Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and fill in your private keys/configurations.
# This file is gitignored and will never be committed.

# ------------------------------------------------------------------------------
# 1. LLM Provider (Cloud vs Local)
# ------------------------------------------------------------------------------
# Set to 'cloud' to use Nvidia NIM / OpenAI compatible cloud endpoint.
# Set to 'local' to use Ollama on your local machine.
OPENCOHOST_LLM_PROVIDER=cloud

# Nvidia NIM / Cloud API settings:
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Examples: meta/llama-3.1-70b-instruct, meta/llama-3.3-70b-instruct, deepseek-ai/deepseek-r1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ------------------------------------------------------------------------------
# 2. Text-to-Speech (TTS) Configuration
# ------------------------------------------------------------------------------
# Available engines:
# - 'edge-tts': Microsoft Cloud TTS (Zero GPU load, free, natural voice, recommended for laptops)
# - 'piper': Local ONNX neural TTS (Lightweight on CPU)
OPENCOHOST_TTS_ENGINE=edge-tts
EDGE_TTS_VOICE=es-AR-TomasNeural

# ------------------------------------------------------------------------------
# 3. Server & Network Configuration
# ------------------------------------------------------------------------------
OPENCOHOST_HOST=127.0.0.1
OPENCOHOST_PORT=8765
OPENCOHOST_FALLBACK_PORT=8770

# ------------------------------------------------------------------------------
# 4. Stream & Chat Integrations (Optional)
# ------------------------------------------------------------------------------
TWITCH_CHANNEL=
TWITCH_BOT_TOKEN=
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=
